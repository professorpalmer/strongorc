{
  "id": "f_cancel_after_kill",
  "track": "orchestrator",
  "slice": "frontier",
  "title": "A cancel file is planted after SIGKILL \u2014 refuse the rest, do not finish the tree",
  "timeout_seconds": 600,
  "facets": [
    "resume",
    "refuse",
    "mutation"
  ],
  "interrupt": {
    "when_file": "state/checkpoint.json",
    "snapshot_globs": [
      "src/early/**/*.ts"
    ],
    "resume": true,
    "plant": {
      "job/cancel.json": "{\n  \"cancel\": true,\n  \"reason\": \"operator-abort\"\n}\n"
    }
  }
}
