{
  "id": "f_budget_rewrite",
  "track": "orchestrator",
  "slice": "frontier",
  "title": "Worker budget drops from 2 to 1 after SIGKILL",
  "timeout_seconds": 600,
  "facets": [
    "resume",
    "budget",
    "mutation"
  ],
  "interrupt": {
    "when_file": "state/checkpoint.json",
    "snapshot_globs": [
      "src/left/**/*.ts"
    ],
    "resume": true,
    "rewrite": {
      "job/budget.json": {
        "max_workers": 1
      }
    }
  }
}
