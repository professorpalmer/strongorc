{
  "id": "b_split_store",
  "track": "orchestrator",
  "slice": "brutal",
  "title": "binbox and namemap",
  "timeout_seconds": 1800,
  "facets": ["lease", "budget", "mutation", "resume", "repo"],
  "interrupt": {
    "when_file": "state/checkpoint.json",
    "snapshot_globs": ["binbox/**/*.py"],
    "resume": true,
    "rewrite": {
      "job/budget.json": {
        "max_workers": 1
      },
      "job/leases.json": {
        "leased": ["namemap"]
      }
    }
  }
}
