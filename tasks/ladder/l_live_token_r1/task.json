{
  "id": "l_live_token_r1",
  "track": "orchestrator",
  "slice": "ladder",
  "title": "kiln token r1",
  "timeout_seconds": 1800,
  "facets": [
    "lease",
    "bind",
    "resume",
    "mutation",
    "repo"
  ],
  "bind": {
    "file": "job/leases.json",
    "field": "nonce",
    "require_in": [
      "kiln/__init__.py",
      "receipts/job.json"
    ]
  },
  "interrupt": {
    "when_file": "state/checkpoint.json",
    "snapshot_globs": [
      "kiln/**/*.py"
    ],
    "resume": true,
    "rewrite": {
      "job/leases.json": {
        "fence": "beta-live",
        "leased": [
          "kiln"
        ]
      }
    }
  }
}
