      ],
      "resume": true,
      "plant": {
        "state/children/leaf.json": {
          "status": "failed"
        }
      }
    },
    {
      "when_file": "state/checkpoint2.json",
      "snapshot_globs": [
        "tray/**/*.py"
      ],
      "resume": true,
      "plant": {
        "state/children/twig.json": {
          "status": "failed"
        }
      }
    }
  ]
}
