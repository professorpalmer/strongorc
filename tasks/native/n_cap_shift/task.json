{
  "id": "n_cap_shift",
  "track": "orchestrator",
  "slice": "native",
  "title": "loom and spool",
  "timeout_seconds": 1800,
  "facets": [
    "lease",
    "budget",
    "mutation",
    "resume",
    "repo"
  ],
  "interrupt": {
    "when_file": "state/checkpoint.json",
    "snapshot_globs": [
      "loom/**/*.py"
    ],
    "resume": true,
    "rewrite": {
      "job/budget.json": {
        "max_workers": 1
      },
      "job/leases.json": {
        "leased": [
          "spool"
        ]
      }
    }
  }
}
